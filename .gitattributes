# Normalise text to LF in the repository; check out with the platform default unless pinned below.
* text=auto

# Scripts that must keep their line endings on every platform
gradlew         text eol=lf
*.sh            text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Source and docs
*.kt            text
*.kts           text
*.java          text
*.xml           text
*.js            text
*.css           text
*.html          text
*.md            text
*.py            text
*.cs            text
*.json          text
*.ini           text
*.svg           text

# Binary assets: never diff or convert
*.jar           binary
*.apk           binary
*.aab           binary
*.keystore      binary
*.jks           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.ico           binary
*.hdr           binary
*.exr           binary
*.ktx2          binary
*.glb           binary
*.gltf          binary
*.bin           binary
*.ogg           binary
*.mp3           binary
*.wav           binary
*.flac          binary
*.mp4           binary
*.webm          binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.exe           binary
*.pyc           binary

# Vendored minified code: treat as generated
games/lib/three.min.js  linguist-vendored -diff
games/lib/vendor/**     linguist-vendored
